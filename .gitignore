# --- Python / CV module ---
.venv/
# Calibration output: lighting- and camera-specific, regenerated by calibrate.py.
ball_detection_algo/params.json
__pycache__/
*.py[cod]
*.egg-info/

# --- CAD / meshes ---
# Blender sources and exported meshes are kept out of git: they are large
# binaries that store a full copy per revision and never diff usefully.
# They live in ball_holder_model/ on disk and are shared out-of-band.
*.blend
*.blend1
*.blend2
*.stl

# --- Claude Code ---
# Shared config (.claude/settings.json) is tracked; per-user local overrides are not.
.claude/settings.local.json

# --- OS / editor cruft ---
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# --- Captured media ---
# Test photos/videos from the camera; keep the repo light. Commit deliberately
# with `git add -f` if a specific frame becomes a regression fixture.
*.mp4
*.avi
captures/

# --- ML models / training output ---
# Same reasoning as the CAD binaries above: large, opaque, and they never diff
# usefully. Trained weights are shared out-of-band; stock weights re-download.
*.pt
*.onnx
*_ncnn_model/
runs/
datasets/
